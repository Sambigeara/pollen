set shell := ["bash", "-euo", "pipefail", "-c"]
set dotenv-path := "../.env"

ssh_args   := "-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR"
repo_root  := justfile_directory() / ".."
prod_tf    := justfile_directory() / "prod"
staging_tf := justfile_directory() / "staging"

default:
    @just --list

# ── Prod (pln.sh) ─────────────────────────────────────────────────────
#
# Day-to-day lifecycle:
#   just prod-plan        # terraform plan → prod.tfplan (review before apply)
#   just prod-apply       # terraform apply prod.tfplan
#   just prod-bootstrap   # auto-install pln on nodes, form the mesh
#   just prod-seed        # seed apex + docs sites
#   just prod-upgrade     # bump pln on every node to the latest release
#   just prod-status
#
# Teardown:
#   just prod-down        # terraform destroy (typed confirmation required)
#
# All recipes run under PLN_CONTEXT=prod. The ctx is an SSH-bridged admin
# handle; no local prod daemon required. `pln ctx add prod root@<host>`
# bootstraps the ctx.

# Preview prod infrastructure changes. Writes prod.tfplan; nothing
# is applied. Run `just prod-apply` to execute the saved plan after
# reviewing it.
#
# Plan prod infra into prod.tfplan.
prod-plan:
    cd {{ prod_tf }} && terraform init -input=false && terraform plan -out=prod.tfplan

# Apply the saved plan from `prod-plan`. Refuses to run if prod.tfplan
# is missing or older than the most-recent edit to the .tf sources;
# stale plans bypass the review that prod-plan is for.
#
# Apply prod.tfplan (refuses if plan is stale; no auto-approve).
prod-apply:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ prod_tf }}
    if [ ! -f prod.tfplan ]; then
      echo "no prod.tfplan; run \`just prod-plan\` first" >&2
      exit 1
    fi
    plan_mtime=$(date -r prod.tfplan +%s)
    for src in *.tf; do
      src_mtime=$(date -r "$src" +%s)
      if [ "$src_mtime" -gt "$plan_mtime" ]; then
        echo "prod.tfplan is older than $src; re-run \`just prod-plan\`" >&2
        exit 1
      fi
    done
    terraform apply prod.tfplan
    rm prod.tfplan

# Destroy prod infrastructure. WARNING: terminates nodes and removes DNS.
# The zone-singleton ruleset, zone settings, and staging cert pack live
# in prod state; staging's HTTP routing and HTTPS ride on them, so tear
# staging down too if you are decommissioning the whole zone.
#
# Destroy prod cluster (typed confirmation; no auto-approve).
prod-down:
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Type 'destroy pln-prod' to confirm: " confirm
    [ "$confirm" = "destroy pln-prod" ] || { echo "aborted"; exit 1; }
    cd {{ prod_tf }} && terraform destroy

# Form the mesh. pln bootstrap ssh auto-installs pln via install.sh on
# any node that doesn't have it, then joins each to the mesh using the
# prod ctx's admin keys. --admin delegates signing authority to each
# prod node. Post-join, each node gets its static-http listener bound
# to :8080 (CF origin rule routes proxied traffic there).
#
# Bootstrap prod nodes: auto-install pln, join mesh, bind :8080.
prod-bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    export PLN_CONTEXT="prod"
    cd {{ prod_tf }}

    echo "forming mesh via pln bootstrap ssh..."
    terraform output -raw bootstrap_targets | pln bootstrap ssh --admin -

    echo "configuring static-http :8080 on each node..."
    terraform output -json node_ips | jq -r 'to_entries[] | "\(.key)\t\(.value)"' | \
      while IFS=$'\t' read -r name ip; do
        ssh {{ ssh_args }} -n "root@$ip" "pln --dir /var/lib/pln set static-http :8080 && systemctl restart pln"
        echo "  $name ($ip) ready"
      done

    expected=$(terraform output -json node_ips | jq 'length')
    just _verify-mesh prod "$expected"

# Seed the apex landing page + install.sh and the docs stub.
#
# The apex bundle is assembled in a tmp dir: the static HTML from
# web/apex/ plus install.sh with the latest release tag baked in (same
# sed goreleaser does at release time). Seeds flow through the prod ctx
# directly to the target daemon; no laptop CAS involved.
#
# Seed pln.sh apex and docs.pln.sh to the prod mesh.
prod-seed:
    #!/usr/bin/env bash
    set -euo pipefail
    export PLN_CONTEXT="prod"
    cd {{ repo_root }}
    VERSION=$(git describe --tags --abbrev=0)
    APEX_BUNDLE=$(mktemp -d)
    trap 'rm -rf "$APEX_BUNDLE"' EXIT
    cp -r web/apex/. "$APEX_BUNDLE"/
    sed "s|^VERSION=\"__VERSION__\"|VERSION=\"$VERSION\"|" scripts/install.sh > "$APEX_BUNDLE/install.sh"
    chmod +x "$APEX_BUNDLE/install.sh"
    pln seed "$APEX_BUNDLE" pln.sh
    pln seed web/docs docs.pln.sh

# Upgrade pln on every node to the latest release. `pln upgrade` is
# localOnly, so it has to run on each node directly; can't go through
# the prod ctx. The .deb postinstall restarts an active service.
#
# Upgrade pln on every prod node to the latest tagged release.
prod-upgrade:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ prod_tf }}
    terraform output -json node_ips | jq -r 'to_entries[] | "\(.key)\t\(.value)"' | \
      while IFS=$'\t' read -r name ip; do
        echo "upgrading $name ($ip)..."
        ssh {{ ssh_args }} -n "root@$ip" "pln upgrade"
      done

# Mesh status via the prod ctx.
prod-status:
    PLN_CONTEXT=prod pln status

# SSH into a prod node by name (eu or us).
prod-ssh name="eu":
    #!/usr/bin/env bash
    set -euo pipefail
    HOST=$(cd {{ prod_tf }} && terraform output -json node_hostnames | jq -r ".[\"{{ name }}\"]")
    exec ssh {{ ssh_args }} "root@$HOST"

# ── Staging (staging.pln.sh) ──────────────────────────────────────────
#
# Mirrors the prod cluster on a separate subdomain and Hetzner firewall.
# Same lifecycle verbs prefixed `staging-`. The staging cluster opens
# extra listeners (control-tls :7443 for wire-mode CLIs, gateway :8088
# for blob/fn share URLs, static-http-domain so <name>-<short-pub>.
# staging.pln.sh resolves to tenant sites) so the full Pollen Cloud
# substrate can be exercised without touching prod.
#
# All recipes run under PLN_CONTEXT=staging-root. Set up the admin ctx
# once with `pln ctx add staging-root root@<eu-ip>` after `staging-apply`.

# Preview staging infrastructure changes. Writes staging.tfplan; nothing
# is applied. Run `just staging-apply` to execute the saved plan after
# reviewing it.
#
# Plan staging infra into staging.tfplan.
staging-plan:
    cd {{ staging_tf }} && terraform init -input=false && terraform plan -out=staging.tfplan

# Apply the saved plan from `staging-plan`. Refuses to run if the plan
# is missing or older than the most-recent edit to the .tf sources.
#
# Apply staging.tfplan (refuses if plan is stale).
staging-apply:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ staging_tf }}
    if [ ! -f staging.tfplan ]; then
      echo "no staging.tfplan; run \`just staging-plan\` first" >&2
      exit 1
    fi
    plan_mtime=$(date -r staging.tfplan +%s)
    for src in *.tf; do
      src_mtime=$(date -r "$src" +%s)
      if [ "$src_mtime" -gt "$plan_mtime" ]; then
        echo "staging.tfplan is older than $src; re-run \`just staging-plan\`" >&2
        exit 1
      fi
    done
    terraform apply staging.tfplan
    rm staging.tfplan

# Destroy staging infrastructure. WARNING: terminates nodes and removes
# DNS. The zone-singleton ruleset and staging cert pack live in prod
# state, so they survive staging-down and tenant HTTPS keeps working.
#
# Destroy staging cluster (typed confirmation; no auto-approve).
staging-down:
    #!/usr/bin/env bash
    set -euo pipefail
    read -r -p "Type 'destroy pln-staging' to confirm: " confirm
    [ "$confirm" = "destroy pln-staging" ] || { echo "aborted"; exit 1; }
    cd {{ staging_tf }} && terraform destroy

# Form the staging mesh. install.sh on each node pulls the latest tagged
# release just so the systemd unit + /var/lib/pln user exist; the
# listener surface gets layered on by `staging-deploy-dev` next.
#
# Bootstrap staging nodes: install released pln and join the mesh.
staging-bootstrap:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ staging_tf }}
    echo "forming mesh via pln bootstrap ssh..."
    terraform output -raw bootstrap_targets | PLN_CONTEXT=staging-root pln bootstrap ssh --admin -

    expected=$(terraform output -json node_ips | jq 'length')
    just _verify-mesh staging-root "$expected"

# Overlay a locally-built linux/amd64 binary on every staging node and
# apply the wire-mode / static-domain / gateway listener config. Run
# this any time `plncl-substrate` advances and you want staging to track
# it without cutting a release. Each node keeps a `pln.prev` copy of
# the previous binary; on health-check failure the recipe rolls back
# that node before exiting non-zero.
#
# Overlay locally-built pln on staging nodes (auto-rollback on failure).
staging-deploy-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ repo_root }}
    BIN={{ repo_root }}/dist/pln-linux-amd64
    echo "building $BIN..."
    GOOS=linux GOARCH=amd64 go build -o "$BIN" ./cmd/pln/

    cd {{ staging_tf }}
    STAGING_DOMAIN=$(terraform output -raw apex_host)
    terraform output -json node_ips | jq -r 'to_entries[] | "\(.key)\t\(.value)"' | \
      while IFS=$'\t' read -r name ip; do
        echo "deploying to $name ($ip)..."
        # scp to /tmp first; install(1) atomically replaces /usr/bin/pln
        # (rename(2) on the path keeps the running process's open file
        # mapping intact so it doesn't crash mid-upload). `scp` direct to
        # /usr/bin/pln fails with ETXTBSY while the daemon is running.
        # The pln.prev copy is the rollback target if the post-restart
        # health probe fails.
        scp -O {{ ssh_args }} "$BIN" "root@$ip:/tmp/pln.new"
        ssh {{ ssh_args }} -n "root@$ip" "
          set -e
          cp /usr/bin/pln /usr/bin/pln.prev
          install -m 0755 /tmp/pln.new /usr/bin/pln
          rm -f /tmp/pln.new
          pln --dir /var/lib/pln set static-http :8080
          pln --dir /var/lib/pln set static-http-domain $STAGING_DOMAIN
          pln --dir /var/lib/pln set control-tls :7443
          pln --dir /var/lib/pln set gateway :8088
          # systemctl restart can exit non-zero (e.g. start-limit-hit) before
          # the probe loop runs; ignore its rc and let the probe decide.
          systemctl restart pln || true
          for i in \$(seq 1 5); do
            if systemctl is-active --quiet pln; then exit 0; fi
            sleep 1
          done
          echo 'pln failed health check after restart; rolling back' >&2
          install -m 0755 /usr/bin/pln.prev /usr/bin/pln
          # Clear systemd's start-limit window before the rollback restart;
          # repeated failures in the probe loop can trip start-limit-hit,
          # which would otherwise refuse the rollback start.
          systemctl reset-failed pln || true
          systemctl restart pln || true
          exit 1
        "
        echo "  $name ($ip) ready"
      done

    expected=$(terraform output -json node_ips | jq 'length')
    just _verify-mesh staging-root "$expected"

# Upgrade pln on every staging node to the latest tagged release. Only
# useful when staging is tracking a release; if you've been running
# `staging-deploy-dev`, use that instead.
#
# Upgrade pln on every staging node to the latest tagged release.
staging-upgrade:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{ staging_tf }}
    terraform output -json node_ips | jq -r 'to_entries[] | "\(.key)\t\(.value)"' | \
      while IFS=$'\t' read -r name ip; do
        echo "upgrading $name ($ip)..."
        ssh {{ ssh_args }} -n "root@$ip" "pln upgrade"
      done

# Mesh status via the staging admin ctx.
staging-status:
    PLN_CONTEXT=staging-root pln status

# SSH into a staging node by name (eu or us).
staging-ssh name="eu":
    #!/usr/bin/env bash
    set -euo pipefail
    HOST=$(cd {{ staging_tf }} && terraform output -json node_hostnames | jq -r ".[\"{{ name }}\"]")
    exec ssh {{ ssh_args }} "root@$HOST"

# ── Internal helpers ─────────────────────────────────────────────────

# Wait up to 60s for `pln status nodes` to report `expected` reachable
# peers via the given context. `formatStatus()` and the self-row code in
# cmd/pln/network.go produce these stable tokens for a reachable peer:
#
#   `(self)` in the NODE column for the local node
#   `direct` or `indirect` in the STATUS column for joined peers
#
# Offline peers are filtered by default. The grep below counts rows
# carrying any of those markers, which gives a reachable-peer total
# including self. `pln status` has no --json flag today; this textual
# parse is the most robust verification surface available.
#
# Poll the given ctx until `expected` reachable peers are visible.
_verify-mesh ctx expected:
    #!/usr/bin/env bash
    set -euo pipefail
    expected={{ expected }}
    actual=0
    echo "verifying mesh formed ($expected peers reachable)..."
    for i in $(seq 1 30); do
      actual=$(PLN_CONTEXT={{ ctx }} pln status nodes 2>/dev/null | \
        grep -Ec '(\(self\)|\bdirect\b|\bindirect\b)' || true)
      actual=${actual:-0}
      if [ "$actual" -ge "$expected" ]; then
        echo "  mesh up: $actual/$expected peers reachable"
        exit 0
      fi
      sleep 2
    done
    echo "mesh failed to form: only $actual/$expected peers reachable" >&2
    exit 1
