# Copy this file to ../.env (the justfile reads from the repo-root .env).
#
# The Hetzner Cloud API token needs the "Read & Write" scope on the project
# that owns pln-prod-* and pln-staging-* servers.
HCLOUD_TOKEN=

# The Cloudflare API token needs:
#   - Zone:Read on the pln.sh zone
#   - Zone:DNS:Edit on the pln.sh zone
#   - Zone:Zone Settings:Edit on the pln.sh zone
#   - Zone:SSL and Certificates:Edit on the pln.sh zone (for ACM)
# Scope the token to the pln.sh zone only. The same token is used by prod,
# staging, and shared, so any extra zones it can touch widen the blast radius.
CLOUDFLARE_API_TOKEN=
